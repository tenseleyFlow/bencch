suite "differential/runtime"

case "mixed_types_refs"
source "../../fixtures/runtime/mixed_types.f90"
opts => O0, O1, O2
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end

