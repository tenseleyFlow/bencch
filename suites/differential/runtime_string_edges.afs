suite "differential/runtime-string-edges"

case "string_empty_matches_references"
source "../../../test_programs/string_empty.f90"
opts => O0
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end

case "string_fixed_multi_matches_references"
source "../../../test_programs/string_fixed_multi.f90"
opts => O0
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end
