suite "differential/runtime-control-flow"

case "if_else_matches_references"
source "../../fixtures/runtime/if_else.f90"
opts => O0, O1, O2
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end

