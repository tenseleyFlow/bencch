suite "differential/runtime-completion"

case "array_intrinsics_matches_references"
source "../../../test_programs/array_intrinsics.f90"
opts => O0, O1
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end

