suite "differential/runtime-numeric-intrinsics"

case "intrinsic_sqrt_matches_references"
source "../../../test_programs/intrinsic_sqrt.f90"
opts => O0
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end

