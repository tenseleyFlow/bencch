suite "differential/runtime-loop-edges"

case "negative_step_matches_references"
source "../../../test_programs/negative_step.f90"
opts => O0
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
end

