suite "runtime/future"

case "io_internal"
source "../../../test_programs/future/io_internal.f90"
armfortas => ir, run
expect run.stdout check-comments
xfail "Internal I/O support is not complete on this branch yet."
end

case "io_backspace"
source "../../../test_programs/future/io_backspace.f90"
armfortas => ir, run
expect run.stdout check-comments
xfail "BACKSPACE is modeled as a known failing runtime gap until file-positioning support lands."
end

case "io_direct_access"
source "../../../test_programs/future/io_direct_access.f90"
armfortas => ir, run
expect run.stdout check-comments
xfail "Direct-access file I/O is modeled as a known failing gap until direct records are implemented."
end
