suite "consistency/runtime-structured"

case "derived_type_method_cli_run_reproducible"
source "../../../test_programs/derived_type_method.f90"
opts => all
armfortas => run
repeat => 3
consistency => cli_run_reproducible
expect run.stdout check-comments
expect run.exit_code equals 0
end

