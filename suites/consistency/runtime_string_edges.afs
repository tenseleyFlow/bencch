suite "consistency/runtime-string-edges"

case "string_empty_cli_run_reproducible"
source "../../../test_programs/string_empty.f90"
opts => all
armfortas => run
repeat => 3
consistency => cli_run_reproducible
expect run.stdout check-comments
expect run.exit_code equals 0
end

case "string_empty_capture_run_matches_cli"
source "../../../test_programs/string_empty.f90"
