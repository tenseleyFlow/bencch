suite "consistency/runtime-computational"

case "fibonacci_cli_run_reproducible"
source "../../../test_programs/fibonacci.f90"
opts => all
armfortas => run
repeat => 3
consistency => cli_run_reproducible
expect run.stdout check-comments
expect run.exit_code equals 0
end

case "fibonacci_capture_run_matches_cli"
source "../../../test_programs/fibonacci.f90"
opts => all
armfortas => run
repeat => 3
consistency => capture_run_vs_cli_run
expect run.stdout check-comments
expect run.exit_code equals 0
end

