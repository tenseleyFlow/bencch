suite "consistency/runtime"

case "runtime_calls_cli_run_reproducible"
source "../../fixtures/backend/runtime_calls.f90"
opts => all
armfortas => run
repeat => 3
consistency => cli_run_reproducible
expect run.stdout contains "backend runtime"
expect run.exit_code equals 0
end

case "runtime_calls_capture_run_matches_cli"
source "../../fixtures/backend/runtime_calls.f90"
opts => all
armfortas => run
repeat => 3
consistency => capture_run_vs_cli_run
expect run.stdout contains "backend runtime"
expect run.exit_code equals 0
end

case "runtime_calls_capture_run_reproducible"
source "../../fixtures/backend/runtime_calls.f90"
opts => all
armfortas => run
repeat => 3
consistency => capture_run_reproducible
expect run.stdout contains "backend runtime"
expect run.exit_code equals 0
end

case "entry_main_cli_run_reproducible"
source "../../fixtures/backend/entry_main.f90"
opts => all
armfortas => run
repeat => 3
consistency => cli_run_reproducible
expect run.stdout contains "7"
expect run.exit_code equals 0
end

case "entry_main_capture_run_matches_cli"
source "../../fixtures/backend/entry_main.f90"
opts => all
armfortas => run
repeat => 3
consistency => capture_run_vs_cli_run
expect run.stdout contains "7"
expect run.exit_code equals 0
end

case "entry_main_capture_run_reproducible"
source "../../fixtures/backend/entry_main.f90"
opts => all
armfortas => run
repeat => 3
consistency => capture_run_reproducible
expect run.stdout contains "7"
expect run.exit_code equals 0
end
