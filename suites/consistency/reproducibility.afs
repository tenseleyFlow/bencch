suite "consistency/reproducibility"

case "runtime_calls_cli_asm_reproducible"
source "../../fixtures/backend/runtime_calls.f90"
opts => all
armfortas => asm
consistency => cli_asm_reproducible
xfail "repeated armfortas -S runs are not deterministic today"
expect asm contains "bl _afs_write_string"
end

case "runtime_calls_cli_obj_reproducible"
source "../../fixtures/backend/runtime_calls.f90"
opts => all
armfortas => obj
consistency => cli_obj_reproducible
xfail "repeated armfortas -c runs are not deterministic today"
expect obj contains "(__TEXT,__text) external _backend_runtime_calls"
end

case "entry_main_cli_asm_reproducible"
source "../../fixtures/backend/entry_main.f90"
opts => all
armfortas => asm
consistency => cli_asm_reproducible
xfail "repeated armfortas -S runs are not deterministic today"
expect asm contains "_main:"
expect asm not-contains "bl _afs_program_init"
end

case "entry_main_cli_obj_reproducible"
source "../../fixtures/backend/entry_main.f90"
opts => all
armfortas => obj
consistency => cli_obj_reproducible
xfail "repeated armfortas -c runs are not deterministic today"
expect obj contains "(__TEXT,__text) external _main"
expect obj not-contains "_afs_program_init"
end
