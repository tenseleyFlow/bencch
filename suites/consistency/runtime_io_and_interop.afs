suite "consistency/runtime-io-and-interop"

case "file_io_cli_run_reproducible"
source "../../../test_programs/file_io.f90"
opts => all
armfortas => run
repeat => 3
consistency => cli_run_reproducible
expect run.stdout check-comments
expect run.exit_code equals 0
end

