suite "modules/frontend-graphs"

case "module_chain_frontend"
entry "../../fixtures/modules/module_chain/main.f90"
file "../../fixtures/modules/module_chain/math_seed.f90"
file "../../fixtures/modules/module_chain/math_values.f90"
file "../../fixtures/modules/module_chain/main.f90"
armfortas => ast, sema
expect ast contains "name: \"math_seed\""
expect ast contains "module: \"math_values\""
expect sema contains "local_name: \"doubled\""
expect sema contains "original_name: \"doubled\""
end

case "rename_only_frontend"
entry "../../fixtures/modules/rename_only/main.f90"
file "../../fixtures/modules/rename_only/math_aliases.f90"
file "../../fixtures/modules/rename_only/main.f90"
armfortas => ast, sema
expect ast contains "local: \"chosen\""
expect ast contains "remote: \"payload\""
expect sema contains "local_name: \"chosen\""
expect sema contains "original_name: \"payload\""
end

case "submodule_frontend"
entry "../../fixtures/modules/submodule_future/main.f90"
file "../../fixtures/modules/submodule_future/parent_mod.f90"
file "../../fixtures/modules/submodule_future/child_impl.f90"
file "../../fixtures/modules/submodule_future/main.f90"
armfortas => ast, sema
expect ast contains "Submodule"
expect sema contains "Submodule"
end

case "visibility_frontend"
entry "../../fixtures/modules/visibility/main_shown.f90"
file "../../fixtures/modules/visibility/visible_values.f90"
file "../../fixtures/modules/visibility/main_shown.f90"
armfortas => ast, sema
expect ast contains "Public"
expect sema contains "local_name: \"shown\""
expect sema not-contains "local_name: \"hidden\""
end

case "visibility_private_import_rejected"
entry "../../fixtures/modules/visibility/main_hidden.f90"
file "../../fixtures/modules/visibility/visible_values.f90"
file "../../fixtures/modules/visibility/main_hidden.f90"
armfortas => sema
expect-fail sema contains "private"
xfail "Private module names are still importable through USE ONLY in graphs."
end

case "fanin_frontend"
entry "../../fixtures/modules/fanin/main.f90"
file "../../fixtures/modules/fanin/base_value.f90"
file "../../fixtures/modules/fanin/offset_value.f90"
file "../../fixtures/modules/fanin/combined_value.f90"
file "../../fixtures/modules/fanin/main.f90"
armfortas => ast, sema
expect ast contains "module: \"base_value\""
expect ast contains "module: \"offset_value\""
expect sema contains "local_name: \"total\""
expect sema contains "original_name: \"total\""
end

case "reexport_chain_frontend"
entry "../../fixtures/modules/reexport_chain/main.f90"
file "../../fixtures/modules/reexport_chain/seed_values.f90"
file "../../fixtures/modules/reexport_chain/relay_values.f90"
file "../../fixtures/modules/reexport_chain/consumer_values.f90"
file "../../fixtures/modules/reexport_chain/main.f90"
armfortas => ast, sema
expect ast contains "module: \"relay_values\""
expect ast contains "module: \"consumer_values\""
expect sema contains "local_name: \"final_value\""
expect sema contains "original_name: \"final_value\""
end

case "diamond_merge_frontend"
entry "../../fixtures/modules/diamond_merge/main.f90"
file "../../fixtures/modules/diamond_merge/shared_seed.f90"
file "../../fixtures/modules/diamond_merge/left_branch.f90"
file "../../fixtures/modules/diamond_merge/right_branch.f90"
file "../../fixtures/modules/diamond_merge/merged_total.f90"
file "../../fixtures/modules/diamond_merge/main.f90"
armfortas => ast, sema
expect ast contains "module: \"left_branch\""
expect ast contains "module: \"right_branch\""
expect sema contains "local_name: \"total\""
expect sema contains "original_name: \"total\""
end

case "rename_hops_frontend"
entry "../../fixtures/modules/rename_hops/main_alias.f90"
file "../../fixtures/modules/rename_hops/base_values.f90"
file "../../fixtures/modules/rename_hops/bridge_aliases.f90"
file "../../fixtures/modules/rename_hops/main_alias.f90"
armfortas => ast, sema
expect ast contains "local: \"lifted\""
expect ast contains "local: \"chosen\""
expect sema contains "local_name: \"chosen\""
expect sema contains "original_name: \"lifted\""
end

case "rename_hops_original_name_rejected"
entry "../../fixtures/modules/rename_hops/main_payload.f90"
file "../../fixtures/modules/rename_hops/base_values.f90"
file "../../fixtures/modules/rename_hops/bridge_aliases.f90"
file "../../fixtures/modules/rename_hops/main_payload.f90"
armfortas => sema
expect-fail sema contains "payload"
xfail "Original names still leak through renamed re-export graphs."
end

case "mixed_only_frontend"
entry "../../fixtures/modules/mixed_only/main_alias.f90"
file "../../fixtures/modules/mixed_only/base_values.f90"
file "../../fixtures/modules/mixed_only/bridge_values.f90"
file "../../fixtures/modules/mixed_only/main_alias.f90"
armfortas => ast, sema
expect ast contains "local: \"kept\""
expect ast contains "local: \"chosen\""
expect sema contains "local_name: \"chosen\""
expect sema contains "local_name: \"beta\""
expect sema contains "original_name: \"kept\""
end

case "mixed_only_hidden_name_rejected"
entry "../../fixtures/modules/mixed_only/main_hidden.f90"
file "../../fixtures/modules/mixed_only/base_values.f90"
file "../../fixtures/modules/mixed_only/bridge_values.f90"
file "../../fixtures/modules/mixed_only/main_hidden.f90"
armfortas => sema
expect-fail sema contains "alpha"
xfail "Original names still leak through mixed ONLY graphs."
end

case "collision_alias_frontend"
entry "../../fixtures/modules/collision_shadow/main_aliases.f90"
file "../../fixtures/modules/collision_shadow/left_values.f90"
file "../../fixtures/modules/collision_shadow/right_values.f90"
file "../../fixtures/modules/collision_shadow/main_aliases.f90"
armfortas => ast, sema
expect ast contains "local: \"left_value\""
expect ast contains "local: \"right_value\""
expect sema contains "local_name: \"left_value\""
expect sema contains "local_name: \"right_value\""
end

case "collision_ambiguous_import_rejected"
entry "../../fixtures/modules/collision_shadow/main_ambiguous.f90"
file "../../fixtures/modules/collision_shadow/left_values.f90"
file "../../fixtures/modules/collision_shadow/right_values.f90"
file "../../fixtures/modules/collision_shadow/main_ambiguous.f90"
armfortas => sema
expect-fail sema contains "ambiguous"
xfail "Ambiguous USE imports are not rejected in graph cases yet."
end
