suite "modules/lowering-graphs"

case "module_chain_ir_values"
entry "../../fixtures/modules/module_chain/main.f90"
file "../../fixtures/modules/module_chain/math_seed.f90"
file "../../fixtures/modules/module_chain/math_values.f90"
file "../../fixtures/modules/module_chain/main.f90"
armfortas => ir
expect ir not-contains "global @math_seed::seed: i32 = zeroinit"
expect ir not-contains "global @math_values::doubled: i32 = zeroinit"
end

case "module_procedure_ir"
entry "../../fixtures/modules/module_procedure/main.f90"
file "../../fixtures/modules/module_procedure/ops.f90"
file "../../fixtures/modules/module_procedure/main.f90"
armfortas => ir
expect ir contains "func @add_one"
xfail "Module procedures are called but not lowered into IR functions."
end

case "reexport_chain_ir_values"
entry "../../fixtures/modules/reexport_chain/main.f90"
file "../../fixtures/modules/reexport_chain/seed_values.f90"
file "../../fixtures/modules/reexport_chain/relay_values.f90"
file "../../fixtures/modules/reexport_chain/consumer_values.f90"
file "../../fixtures/modules/reexport_chain/main.f90"
armfortas => ir
expect ir not-contains "global @relay_values::lifted: i32 = zeroinit"
expect ir not-contains "global @consumer_values::final_value: i32 = zeroinit"
end

case "diamond_merge_ir_values"
entry "../../fixtures/modules/diamond_merge/main.f90"
file "../../fixtures/modules/diamond_merge/shared_seed.f90"
file "../../fixtures/modules/diamond_merge/left_branch.f90"
file "../../fixtures/modules/diamond_merge/right_branch.f90"
file "../../fixtures/modules/diamond_merge/merged_total.f90"
file "../../fixtures/modules/diamond_merge/main.f90"
armfortas => ir
expect ir not-contains "global @left_branch::left: i32 = zeroinit"
expect ir not-contains "global @right_branch::right: i32 = zeroinit"
expect ir not-contains "global @merged_total::total: i32 = zeroinit"
end

case "rename_hops_ir_values"
entry "../../fixtures/modules/rename_hops/main_alias.f90"
file "../../fixtures/modules/rename_hops/base_values.f90"
file "../../fixtures/modules/rename_hops/bridge_aliases.f90"
file "../../fixtures/modules/rename_hops/main_alias.f90"
armfortas => ir
expect ir not-contains "global @base_values::payload: i32 = zeroinit"
expect ir not-contains "global @bridge_aliases::lifted: i32 = zeroinit"
end

case "mixed_only_ir_values"
entry "../../fixtures/modules/mixed_only/main_alias.f90"
file "../../fixtures/modules/mixed_only/base_values.f90"
file "../../fixtures/modules/mixed_only/bridge_values.f90"
file "../../fixtures/modules/mixed_only/main_alias.f90"
armfortas => ir
expect ir not-contains "global @mixed_only_values::alpha: i32 = zeroinit"
expect ir not-contains "global @mixed_only_values::beta: i32 = zeroinit"
end

case "collision_alias_ir_values"
entry "../../fixtures/modules/collision_shadow/main_aliases.f90"
file "../../fixtures/modules/collision_shadow/left_values.f90"
file "../../fixtures/modules/collision_shadow/right_values.f90"
file "../../fixtures/modules/collision_shadow/main_aliases.f90"
armfortas => ir
expect ir not-contains "global @collision_left_values::payload: i32 = zeroinit"
expect ir not-contains "global @collision_right_values::payload: i32 = zeroinit"
end

case "layered_total_ir_values"
entry "../../fixtures/modules/layered_leaves/main_total.f90"
file "../../fixtures/modules/layered_leaves/root_seed.f90"
file "../../fixtures/modules/layered_leaves/left_metrics.f90"
file "../../fixtures/modules/layered_leaves/right_metrics.f90"
file "../../fixtures/modules/layered_leaves/total_metrics.f90"
file "../../fixtures/modules/layered_leaves/main_total.f90"
armfortas => ir
expect ir not-contains "global @layered_root_seed::seed: i32 = zeroinit"
expect ir not-contains "global @layered_left_metrics::doubled: i32 = zeroinit"
expect ir not-contains "global @layered_right_metrics::shifted: i32 = zeroinit"
expect ir not-contains "global @layered_total_metrics::total: i32 = zeroinit"
end

case "layered_gap_ir_values"
entry "../../fixtures/modules/layered_leaves/main_gap.f90"
file "../../fixtures/modules/layered_leaves/root_seed.f90"
file "../../fixtures/modules/layered_leaves/left_metrics.f90"
file "../../fixtures/modules/layered_leaves/right_metrics.f90"
file "../../fixtures/modules/layered_leaves/delta_metrics.f90"
file "../../fixtures/modules/layered_leaves/main_gap.f90"
armfortas => ir
expect ir not-contains "global @layered_root_seed::seed: i32 = zeroinit"
expect ir not-contains "global @layered_left_metrics::doubled: i32 = zeroinit"
expect ir not-contains "global @layered_right_metrics::shifted: i32 = zeroinit"
expect ir not-contains "global @layered_delta_metrics::gap: i32 = zeroinit"
end
