suite "differential/known_gaps"

case "io_internal_refs"
source "../../../test_programs/future/io_internal.f90"
armfortas => run
differential => gfortran, flang-new
expect run.stdout check-comments
expect run.exit_code equals 0
xfail "Internal I/O currently diverges from both reference compilers."
end

